@model ML.Producto.Producto
@{
    ViewBag.Title = "CardsProducto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--Importar Bootstrap para Iconos-->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<link rel="stylesheet" href="~/Content/CSS/estiloCards.css" />

<h2>CardsProducto</h2>

<!--Botón para ir al Formulario-->
<a href="@Url.Action("Form", "Producto")" class="btn btn-primary mb-3">Agregar Registro</a>

@using (Html.BeginForm("CardsProducto", "CardsProducto", FormMethod.Post))
{
    <div class="card p-3 bg-light shadow-sm">
        <div class="row">
            <div class="col">
                @Html.LabelFor(model => model.Subcategoria.Categoria.IdCategoria, new { @class = "form-label text-dark fw-bold" })
                @Html.DropDownListFor(model => model.Subcategoria.Categoria.IdCategoria, new SelectList
                (Model.Subcategoria.Categoria.Categorias, "IdCategoria", "Nombre"), "Selecciona una Categoría", new
                { @onchange = "SubcategoriaGetByIdCategoria()", @id = "ddlCategoria", @class = "form-control" })

                @Html.ValidationMessageFor(model => model.Subcategoria.Categoria.IdCategoria, "", new { @class = "text-danger" })
            </div>
            <div class="col">
                @Html.LabelFor(model => model.Subcategoria.IdSubcategoria, new { @class = "form-label text-dark fw-bold" })
                @Html.DropDownListFor(model => model.Subcategoria.IdSubcategoria, new SelectList(String.Empty), "Selecciona una Subcategoria", new
                { @disabled = "true", @id = "ddlSubcategoria", @class = "form-control" })

                @Html.ValidationMessageFor(model => model.Subcategoria.IdSubcategoria, "", new { @class = "text-danger" })
            </div>
            <div class="col d-flex align-items-end">
                <button type="submit" class="btn btn-dark">Buscar</button>
            </div>
        </div>
    </div>
}


@if (Model.Productos != null && Model.Productos.Count > 0)
{
    <div class="row mt-4">
        @foreach (ML.Producto.Producto producto in Model.Productos)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">

                    @if (producto.Imagen != null)
                    {
                        <img id="imgProducto" src="@($"data:image/jpeg;base64,{Convert.ToBase64String(producto.Imagen)}")" class="card-img-top" width="200" height="280" />
                    }
                    else
                    {
                        <img id="imgProducto" src="https://www.mon-site-bug.fr/uploads/products/default-product.png" class="card-img-top" width="200" height="280" />

                    }

                    <!--<img src="@@producto.Imagen" class="card-img-top" alt="Producto" style="height: 200px; object-fit: cover;">-->
                    <div class="card-body">
                        <h5 class="card-title">@producto.Nombre</h5>
                        <p class="card-text">@producto.Descripcion</p>
                        <p class="card-text fw-bold">$@producto.Precio</p>
                    </div>
                    <div class="card-footer text-end">

                        <a href="@Url.Action("Form", "Producto", new { idProducto = producto.IdProducto })"
                           class="btn btn-warning">
                            Actualizar
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a href="@Url.Action("Delete", "CardsProducto", new { idProducto = producto.IdProducto })"
                           class="btn btn-danger" onclick="return confirm('Seguro que lo quieres borrar?')">
                            Eliminar
                            <i class="bi bi-trash3"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/jqueryval")

<script>
    var Rutas = {
        pathGetByIdCategoria: "@Url.Action("GetByIdCategoria", "CardsProducto")"
    };
</script>

<script src="~/Scripts/Cards/CardsValidaciones.js"></script>
