@model ML.Producto.Sucursal
@{
    ViewBag.Title = "GetAll";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<h2>Sucursales</h2>

<a href="@Url.Action("Form", "Sucursal")" class="btn btn-primary mb-3">Agregar Sucursal</a>

<link rel="stylesheet" type="text/css" href="~/Content/CSS/Style.css" />


<div class="row">
    <div class="col">
        <div class="table-responsive">
            <table class="table table-dark table-striped">
                <thead>
                    <tr>
                        <th scope="col">Sucursal</th>
                        <th scope="col">Actualizar</th>
                        <th scope="col">Eliminar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ML.Producto.Sucursal sucursal in Model.Sucursales)
                    {
                        <tr>
                            <td>@sucursal.Nombre</td>

                            <td>
                                <a href="@Url.Action("Form", "Sucursal", new { idSucursal = sucursal.IdSucursal })"
                                   class="btn btn-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>

                            <td>
                                <a href="@Url.Action("Delete", "Sucursal", new { idSucursal = sucursal.IdSucursal })"
                                   class="btn btn-danger" onclick="return confirm('¿Seguro que lo quieres borrar?')">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col">
        <!--The div element for the map -->
        <div id="map"></div>
    </div>

</div>

<script async defer
        src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDCt5qUAX_luLPwkcfUOJutLLavQwVFgcA&callback=initMap">
</script>

<!--Convertir lista de sucursales en un arreglo JS-->
<script>
    var sucursales = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Sucursales));
</script>

<script src="~/Scripts/Sucursal/Sucursal.js"></script>