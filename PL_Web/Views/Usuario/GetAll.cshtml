    function GuardarOActualizar() {

    }

    function GetById(idUsuario) {
        $.ajax({
            url: '@Url.Action("Form", "Usuario")',
            type: 'GET',
            data: { idUsuario: idUsuario },
            dataType: 'JSON',
            success: function (result) {
                if (result.Correct) {
                    var usuario
                }
            }
        });
    }
</script>