@model ML.Usuario

@{
    ViewBag.Title = "GetAll";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<!--Intento de CRUD solo JS-->

<!--Ocultar la busqueda usando COLLAPSE-->
<p>                                                                                     <!--Nombre del Id del DIV-->
    <button type="button" data-bs-toggle="collapse" class="btn btn-dark mt-3" data-bs-target="#DivBusquedaAbierta">Busqueda Abierta</button>
    <button type="button" data-bs-toggle="collapse" class="btn btn-secondary mt-3" data-bs-target="#extraView">Carga Masiva</button>
</p>



<!-- Carga Masiva -->
<div id="extraView" class="collapse multi-section">
    <div class="card p-3 bg-light shadow-sm">
        @using (Html.BeginForm("CargaMasiva", "Usuario", FormMethod.Post, new { @enctype = "multipart/form-data" }))
        {
            if (Session["RutaExcel"] == null)
            {
                <input type="file" name="inptExcel" id="inptExcel" onchange="validarExtensionExcel()" accept=".xlsx" />
                <button type="submit" class="btn btn-dark mt-3" onclick="return validarArchivo()"> Validar Registro</button>
            }
            else
            {
                <button type="submit" class="btn btn-dark mt-3">INSERTAR</button>
            }

        }
    </div>
</div>

<p></p>

<div class="container">
    <div class="row">
        <div class="col-12">
            <h1>Prueba</h1>
            <h5>CRUD JS</h5>
        </div>
        <div class="col-12">

            <!-- Button trigger modal -->
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#staticBackdrop">
                Agregar
            </button>

            <!-- Modal -->
            <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5" id="staticBackdropLabel">Agregar Usuario</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form>
                                <div class="modal-header">
                                    <label class="gap-lg-2">Nombre</label>
                                    <input id="txtNombre" class="form-control rounded-pill" />
                                </div>
                                <div class="modal-header">
                                    <label class="gap-lg-2">Apellido Paterno</label>
                                    <input id="txtApellidoPaterno" class="form-control rounded-pill" />
                                    <label class="gap-lg-2 m-1">Apellido Materno</label>
                                    <input id="txtApellidoMaterno" class="form-control rounded-pill" />
                                </div>
                                <div class="modal-header">

                                </div>
                                <div class="border-light">
                                    <label class="gap-lg-3">Email</label>
                                    <input id="txtEmail" class="form-control rounded-pill" />
                                </div>
                                <div class="border-light">
                                    <label class="gap-lg-3">Password</label>
                                    <input id="txtPassword" class="form-control rounded-pill" />
                                </div>
                                <div class="border-light">
                                    <label class="gap-lg-3">Fecha de Nacimiento</label>
                                    <input id="txtFechaNacimiento" class="form-control rounded-pill" />
                                </div>
                                <div class="border-light">
                                    <label class="gap-lg-3">Sexo</label>
                                    <input type="radio" name="sexo" value="M" id="txtSexo"> <label for="txtSexo">Masculino</label>
                                    <input type="radio" name="sexo" value="F" id="txtSexoF" /> <label for="txtSexoF">Femenino</label>

                                </div>
                                <div class="border-light">
                                    <label class="gap-lg-3">Telefono</label>
                                    <input id="txtTelefono" class="form-control rounded-pill" />
                                </div>
                                <div class="border-light">
                                    <label class="gap-lg-3">Celular</label>
                                    <input id="txtCelular" class="form-control rounded-pill" />
                                </div>
                                <div class="border-light">
                                    <label class="gap-lg-3">Curp</label>
                                    <input id="txtCRUP" class="form-control rounded-pill" />
                                </div>
                                <div class="border-light">
                                    <label class="gap-lg-3">ROLLLLLOLLLLLLLLLLLLLLOL</label>
                                    <input id="txtRol" class="form-control rounded-pill" />
                                </div>
                                <div class="border-light">
                                    <label class="gap-lg-3">Calle</label>
                                    <input id="txtCalle" class="form-control rounded-pill" />
                                </div>
                                <div class="border-light">
                                    <label class="gap-lg-3">Numero exterior</label>
                                    <input id="txtNumeroExterior" class="form-control rounded-pill" />
                                </div>
                                <div class="border-light">
                                    <label class="gap-lg-3">Numero interior</label>
                                    <input id="txtNumeroInterior" class="form-control rounded-pill" />
                                </div>
                                <div class="border-light">
                                    <label class="gap-lg-3">Colonia</label>
                                    <input id="txtColonia" class="form-control rounded-pill" />
                                </div>
                                <div class="border-light">
                                    <label class="gap-lg-3">Municipio</label>
                                    <input id="txtMunicipio" class="form-control rounded-pill" />
                                </div>
                                <div class="border-light">
                                    <label class="gap-lg-3">Estado</label>
                                    <input id="txtEstado" class="form-control rounded-pill" />
                                </div>
                                <div class="border-light">
                                    <label class="gap-lg-3">Imagen</label>
                                    <input id="txtImagen" class="form-control rounded-pill" />
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                            <button type="button" class="btn btn-primary" onclick="GetAll()">Aceptar</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive mt-4">
                <table class="table table-dark table-striped">
                    <thead>
                        <tr>
                            <th>Editar</th>
                            <th>UserName</th>
                            <th>Nombre</th>
                            <th>Apellido Paterno</th>
                            <th>Apellido Materno</th>
                            <th>Email</th>
                            <th>Password</th>
                            <th>Fecha de Nacimiento</th>
                            <th>Sexo</th>
                            <th>Telefono</th>
                            <th>Celular</th>
                            <th>CURP</th>
                            <th>Nombre Rol</th>
                            <th>Dirección</th>
                            <th>Imagen</th>
                            <th>Eliminar</th>
                        </tr>
                    </thead>
                    <tbody id="tbody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!--Intentando hacer las funciones-->
<script src="~/Scripts/jquery-3.7.0.js"></script>

<script>
    GetAll();

    function GetAll() {
        $.ajax({
            //url: '@@Url.Action("GetAllusuario", "Usuario")', RUTA RAZOR
            url: '/CRUDjs/GetAllusuario',
            type: 'GET',
            dataType: 'JSON',
            success: function (result) {
                if (result.Correct) {

                    var usuarios = result.Objects;
                    var tabla = document.getElementById("tbody");
                    var row = ``;

                    $.each(usuarios, function (index, usuario) {
                        var imagen = usuario.ImagenBase64
                            ? `<img src="data:image/png;base64,${usuario.ImagenBase64} alt=Imagen del usuario"
                                style="width: 50px; height: 50px;">`
                            : "No hay imagen";

                        row += `
                        <tr>
                            <td><a class="btn btn-warning" onclick="GetById(${usuario.IdUsuario})"> <i class="bi bi-pencil-square"></i></a></td>
                            <td>${usuario.UserName}</td>
                            <td>${usuario.Nombre}</td>
                            <td>${usuario.ApellidoPaterno}</td>
                            <td>${usuario.ApellidoMaterno}</td>
                            <td>${usuario.Email}</td>
                            <td>${usuario.Password}</td>
                            <td>${usuario.FechaNacimiento}</td>
                            <td>${usuario.Sexo}</td>
                            <td>${usuario.Telefono}</td>
                            <td>${usuario.Celular}</td>
                            <td>${usuario.CURP}</td>
                            <td>${usuario.Rol.Nombre}</td>
                            <td> ${usuario.Direccion.Calle}, ${usuario.Direccion.NumeroInterior}, ${usuario.Direccion.NumeroExterior},
                            ${usuario.Direccion.Colonia.Nombre}, ${usuario.Direccion.Colonia.CodigoPostal}, ${usuario.Direccion.Colonia.Municipio.Nombre},
                            ${usuario.Direccion.Colonia.Municipio.Estado.Nombre} </td>
                            <td>${usuario.imagen}</td>
                            <td><a class="btn btn-danger" onclick="Delete(${usuario.IdUsuario})"><i class="bi bi-trash"></i></a></td>
                        </tr>
                    `;
                    });

                    $('#tbody').empty().append(row);
                } else {
                    alert('Error');
                }
            }
        });
    }

    function Delete(id) {
        console.log(id);
        if (confirm('¿Estás seguro de eliminar jsjs?')) {
            $.ajax({
                url: '/Usuario/Delete',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ idUsuario: id }),
                success: function (response) {
                    if (response.Success) {
                        alert('El usuario fue eliminado correctamente');
                        GetAll();
                    } else {
                        alert('Error al eliminar' + response.Message);
                    }
                }
            });
        }
    }

    function OpenForm() {
        $("#staticBackdrop").modal("show");
        ClearForm();

    }

    function ClearForm() {

